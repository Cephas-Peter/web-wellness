---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Get in touch or request an appointment with Wellness with Lindz.">
  <section class="section">
    <div class="container contact__grid">
      <div>
        <p class="eyebrow">Get in touch</p>
        <h1>Questions, or ready to book?</h1>
        <p>
          Use the form for a general question, or jump straight to requesting an appointment below.
          Expect a reply within one business day.
        </p>

        <dl class="contact__facts">
          <div><dt>Email</dt><dd><a href="mailto:hello@wellnesswithlindz.co.za">hello@wellnesswithlindz.co.za</a></dd></div>
          <div><dt>Location</dt><dd>Johannesburg, South Africa &mdash; and online</dd></div>
          <div><dt>Hours</dt><dd>Mon&ndash;Fri, 08:00&ndash;17:00</dd></div>
        </dl>

        <form class="form" action="https://formspree.io/f/REPLACE_WITH_FORM_ID" method="POST">
          <h2 class="form__title">General enquiry</h2>
          <!-- Honeypot field for spam protection: kept hidden from real visitors via CSS -->
          <div class="form__honeypot" aria-hidden="true">
            <label for="company">Company</label>
            <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <label for="name">Name</label>
          <input id="name" name="name" type="text" required />

          <label for="email">Email</label>
          <input id="email" name="email" type="email" required />

          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" required></textarea>

          <button type="submit" class="btn btn-primary">Send message</button>
        </form>
      </div>

      <div id="appointment" class="appointment">
        <form class="form form--card" action="https://formspree.io/f/REPLACE_WITH_FORM_ID" method="POST">
          <h2 class="form__title">Request an appointment</h2>
          <p class="form__note">This sends a request — nothing is confirmed until you hear back by email.</p>

          <div class="form__honeypot" aria-hidden="true">
            <label for="company-2">Company</label>
            <input id="company-2" name="company" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <label for="a-name">Name</label>
          <input id="a-name" name="name" type="text" required />

          <label for="a-email">Email</label>
          <input id="a-email" name="email" type="email" required />

          <label for="a-service">What are you looking for?</label>
          <select id="a-service" name="service" required>
            <option value="">Choose one</option>
            <option>Individual counselling</option>
            <option>Couples sessions</option>
            <option>Family sessions</option>
            <option>Online consultation</option>
            <option>Once-off consultation</option>
            <option>Not sure yet</option>
          </select>

          <label for="a-time">Preferred days/times</label>
          <input id="a-time" name="preferred_time" type="text" placeholder="e.g. weekday mornings" />

          <label for="a-notes">Anything you'd like to add (optional)</label>
          <textarea id="a-notes" name="notes" rows="4"></textarea>

          <button type="submit" class="btn btn-primary">Request appointment</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact__grid {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 900px) {
    .contact__grid { grid-template-columns: 1fr 1fr; align-items: start; }
  }
  .contact__facts { margin: 1.5rem 0 2.5rem; }
  .contact__facts div { padding: 0.6rem 0; border-top: 1px solid var(--line); }
  .contact__facts div:first-child { border-top: none; }
  .contact__facts dt { font-size: 0.82rem; color: var(--ink-soft); }
  .contact__facts dd { margin: 0; font-weight: 500; }

  .appointment { position: sticky; top: 6.5rem; }

  .form { display: flex; flex-direction: column; gap: 0.35rem; }
  .form--card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.8rem;
  }
  .form__title { margin-bottom: 0.2em; }
  .form__note { font-size: 0.88rem; color: var(--ink-soft); margin-top: 0; margin-bottom: 1rem; }
  .form label { font-size: 0.85rem; font-weight: 700; margin-top: 0.8rem; }
  .form input, .form select, .form textarea {
    font: inherit;
    padding: 0.7em 0.8em;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--sand);
    color: var(--ink);
  }
  .form textarea { resize: vertical; }
  .form button { margin-top: 1.4rem; align-self: flex-start; }
  .form__honeypot { position: absolute; left: -9999px; }
</style>
