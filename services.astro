---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  {
    name: 'Counselling Services',
    detail: 'Wellness With Lindz offers individual counselling, couples counselling, family related counselling and more. We can assist you with relationship issues and marital issues.',
  },
  {
    name: 'Trauma Counselling',
    detail: 'In South Africa, trauma is labelled a preventable burden of disease. In the context of a country gripped by violence due to certain factors such as high unemployment rates in South Africa, and the physical and psychological injuries that can result, trauma is one of the growing public health concerns that have made health care and prevention so challenging.',
  },
  {
    name: 'Bereavement and Loss Counselling',
    detail: 'Support for families navigating a specific transition — separation, illness, or a shift in family structure.',
  },
  {
    name: 'Life Adjustment & Transition',
    detail: 'We all are aware that certain life changes can take a toll on our emotional health, resulting in anxiety and depression sometimes. If you feel like you’re having difficulties adjusting to a new situation, i.e., marriage transition, a birth of a child, loss of a job, etc, get in touch with us for support and how we can help navigate this journey.',
  },
  {
    name: 'Substance Abuse Counselling',
    detail: 'Excessive use of substances such as alcohol, illegal drugs and the use of prescription or over-the-counter drugs for purposes other than those for which they are meant to be used can lead to physical, social or emotional harm, as well as work related issues. Here at Wellness with Lindz, we will walk this journey of recovery with you.',
  },
  {
    name: 'Supervised Visitations',
    detail: 'Wellness with Lindz is guided by the best interests of children being paramount. Section 9 of the Child Care Act (No. 38 of 2005: Children’s Act, 2005) highlights that “In all matters concerning the care, protection and well-being of a child the standard that the child’s best interest is of paramount importance, must be applied. Supervised Visitations are one of the services offered by Wellness with Lindz. These are often court ordered visitations that takes place between a caregiver and a minor child, supervised by a qualified 3rd party/ professional, such as a Social Worker for the full duration of the contact time between the caregiver and the child. Wellness with Lindz is available to act as a supervisory third person during scheduled visitations between parent and child(ren).',
  },
];
---

<BaseLayout title="Services" description="Individual, couples, family, and online sessions at Wellness with Lindz.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Services</p>
      <h1>How we can work together.</h1>
      <p style="max-width: 76ch;">
        Wellness with Lindz offers professional assistance and guidance on personal or psychological problems, as well as work related issues. We encourage people to address the issues they are facing with an eventual goal to overcome those problems.
      </p>

      <div class="row-list" style="margin-top: 2.5rem;">
        {services.map((s) => (
          <div class="row-list__item">
            <h3>{s.name}</h3>
            <p>{s.detail}</p>
          </div>
        ))}
      </div>

      <p style="margin-top:2.5rem;">
        <a href="/contact#appointment" class="btn btn-primary">Request an appointment</a>
      </p>
    </div>
  </section>
</BaseLayout>
