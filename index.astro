---
import BaseLayout from '../layouts/BaseLayout.astro';
import TestimonialStrip from '../components/TestimonialStrip.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const services = [
  {
    name: 'Individual counselling',
    detail: 'One-on-one sessions for anxiety, life transitions, grief, and the ordinary weight of daily life.',
  },
  {
    name: 'Couples sessions',
    detail: 'A structured space to work through recurring conflict, communication, and trust.',
  },
  {
    name: 'Online consultations',
    detail: 'The same practice, over video, for anyone who can\u2019t make it in person.',
  },
];
---

<BaseLayout title="Wellness with Lindz" description="A calmer, more grounded approach to therapy and counselling in Johannesburg and online.">
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <h1>Therapy that starts with a conversation, not a form.</h1>
        <p class="hero__lede">
          A private practice built around real, unhurried conversation — for individuals and couples working
          through anxiety, grief, relationships, and the everyday weight of being a person.
        </p>
        <div class="hero__actions">
          <a href="/contact#appointment" class="btn btn-primary">Request an appointment</a>
          <a href="/about" class="btn btn-ghost">Meet the practice</a>
        </div>
      </div>
      <div class="hero__mark" aria-hidden="true">
        <svg viewBox="0 0 240 240" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="120" cy="120" r="118" stroke="#8B4A3B" stroke-width="1.5"/>
          <path d="M40 130C60 80 100 40 150 40C190 40 210 80 200 120C190 160 140 200 100 200C65 200 45 175 40 130Z" stroke="#223028" stroke-width="1.5"/>
        </svg>
      </div>
    </div>
  </section>

  <section class="section section-divide">
    <div class="container">
      <p class="eyebrow">What we work on</p>
      <h2>A few of the things people bring in.</h2>
      <div class="row-list">
        {services.map((s) => (
          <div class="row-list__item">
            <h3>{s.name}</h3>
            <p>{s.detail}</p>
          </div>
        ))}
      </div>
      <p style="margin-top:2rem;"><a href="/services" class="btn btn-ghost">See all services</a></p>
    </div>
  </section>

  <section class="section section-divide">
    <div class="container">
      <p class="eyebrow">In their words</p>
      <h2>What sessions here are actually like.</h2>
      <TestimonialStrip />
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section section-divide">
      <div class="container">
        <p class="eyebrow">From the blog</p>
        <h2>Notes worth reading before you book.</h2>
        <div class="posts">
          {posts.map((post) => (
            <a class="posts__item" href={`/blog/${post.slug}`}>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="cta">
    <div class="container cta__inner">
      <h2>Ready when you are.</h2>
      <p>Sessions run weekday mornings and afternoons, in person in Johannesburg or online.</p>
      <a href="/contact#appointment" class="btn btn-ghost-light">Request an appointment</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: clamp(3rem, 7vw, 6rem) 0 clamp(2.5rem, 5vw, 4rem); }
  .hero__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 860px) {
    .hero__grid { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); }
  }
  .hero__lede { font-size: 1.1rem; color: var(--ink-soft); }
  .hero__actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1.5rem; }
  .hero__mark { justify-self: center; width: min(260px, 70vw); }

  .posts {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  @media (min-width: 700px) {
    .posts { grid-template-columns: 1fr 1fr; }
  }
  .posts__item {
    display: block;
    text-decoration: none;
    padding: 1.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
  }
  .posts__item h3 { margin-bottom: 0.4em; }
  .posts__item p { color: var(--ink-soft); margin: 0; }

  .cta {
    background: var(--ink);
    color: var(--sand);
    padding: clamp(3rem, 6vw, 5rem) 0;
  }
  .cta__inner { text-align: left; }
  .cta h2 { color: var(--sand); }
  .cta p { color: rgba(237, 230, 216, 0.8); }
</style>
