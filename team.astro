---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const members = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Team" description="Meet the practitioners at Wellness with Lindz.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Team</p>
      <h1>Who you'll be talking to.</h1>

      <div class="team-list">
        {members.map(async (member) => {
          const { Content } = await member.render();
          return (
            <article class="team-list__item">
              <div class="team-list__photo" aria-hidden="true"></div>
              <div>
                <h2>{member.data.name}</h2>
                <p class="team-list__role">{member.data.role}</p>
                <div class="team-list__bio"><Content /></div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .team-list { display: grid; gap: 3rem; margin-top: 2.5rem; }
  .team-list__item {
    display: grid;
    gap: 1.6rem;
  }
  @media (min-width: 700px) {
    .team-list__item { grid-template-columns: 160px 1fr; align-items: start; }
  }
  .team-list__photo {
    width: 160px;
    height: 160px;
    border-radius: var(--radius);
    background: linear-gradient(155deg, var(--sand-deep), var(--card));
    border: 1px solid var(--line);
  }
  .team-list__role { color: var(--clay-dark); font-weight: 700; font-size: 0.92rem; margin-bottom: 0.8em; }
  .team-list__bio :global(p) { color: var(--ink-soft); }
</style>
